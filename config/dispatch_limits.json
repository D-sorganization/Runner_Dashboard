{
  "version": 1,
  "description": "Fleet armed-PR WIP cap (RD-CI-005 / issue #2029) and queue depth dispatch delay (RD-CI-033 / issue #2034). Roll back with enabled=false.",
  "enabled": true,
  "shadow_mode": true,
  "max_healthy_armed": 12,
  "reservation_ttl_seconds": 300,
  "reconcile_interval_seconds": 900,
  "scope_repositories": null,
  "required_checks_path": "config/ci-required-checks-live.json",
  "fallback_checks_path": "config/required_status_checks_policy.json",
  "disarm_workflow": "conflict-disarm.yml",
  "disarm_transient_streak_limit": 2,
  "disarm_cooldown_seconds": 3600,
  "queue_depth_delay": {
    "enabled": false,
    "shadow_mode": true,
    "max_queued_runs": 20,
    "max_queued_jobs": 50,
    "max_queue_p95_seconds": 600.0,
    "exempt_tiers": ["user", "repair"],
    "exempt_dispatch_kinds": ["ci_fix", "conflict"]
  }
}

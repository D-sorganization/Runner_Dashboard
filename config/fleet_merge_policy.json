{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "description": "Fleet merge-queue and branch-protection settings policy (RM#1890, RM#1900, RD#1850). Source of truth for fleet merge configuration.",
  "repositories": [
    "D-sorganization/AffineDrift",
    "D-sorganization/Bitnet_Launcher",
    "D-sorganization/Controls",
    "D-sorganization/Copyright-and-Legal-Review",
    "D-sorganization/DC-Bus-Testing",
    "D-sorganization/Design-Procedures",
    "D-sorganization/Drake_Models",
    "D-sorganization/Facility-Reporting",
    "D-sorganization/Florida-Compressor",
    "D-sorganization/Florida-Controls",
    "D-sorganization/Florida-Superheater",
    "D-sorganization/Forgejo_Client_Bootstrap",
    "D-sorganization/Games",
    "D-sorganization/Gasification_Model",
    "D-sorganization/Hardware_Management",
    "D-sorganization/ICR-Operations",
    "D-sorganization/Launch-Monitor-Data",
    "D-sorganization/Launch-Monitor-Flight-Model-Campaign",
    "D-sorganization/MEB_Conversion",
    "D-sorganization/Maxwell_Daemon",
    "D-sorganization/MuJoCo_Models",
    "D-sorganization/OpenSim_Models",
    "D-sorganization/Operations_Manual_and_Training",
    "D-sorganization/Pinocchio_Models",
    "D-sorganization/Playground",
    "D-sorganization/Programmatic_PID",
    "D-sorganization/Quat_Engine",
    "D-sorganization/REE-Recovery",
    "D-sorganization/Reporting-Templates",
    "D-sorganization/Repository_Management",
    "D-sorganization/Runner_Dashboard",
    "D-sorganization/Tools",
    "D-sorganization/Tools_Private",
    "D-sorganization/UpstreamDrift",
    "D-sorganization/Worksheet_Workshop",
    "D-sorganization/Zeus-Gas-Bottling-Proposal",
    "D-sorganization/al-hcl-hydrogen-kinetics",
    "D-sorganization/half-ton-controls",
    "D-sorganization/openflight_development",
    "D-sorganization/public-web-management",
    "D-sorganization/rate-of-closure-explorer"
  ],
  "default_branch": "main",
  "require_branches_up_to_date": false,
  "repo_settings": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "delete_branch_on_merge": true
  },
  "merge_queue": {
    "required": true,
    "parameters": {
      "check_response_timeout_minutes": 180,
      "grouping_strategy": "ALLGREEN",
      "max_entries_to_build": 5,
      "max_entries_to_merge": 5,
      "merge_method": "SQUASH",
      "min_entries_to_merge": 1,
      "min_entries_to_merge_wait_minutes": 5
    }
  },
  "workflows": {
    "require_merge_group_on_required_checks": true,
    "disallowed_workflows": ["Auto-Update PRs"]
  }
}

#!/usr/bin/env bash
set -euo pipefail
bash -lc 'for root in "${RUNNER_DASHBOARD_REPO_ROOT}" "${RUNNER_DASHBOARD_DEPLOY_DIR}" "$HOME/actions-runners/dashboard/current" "$(git rev-parse --show-toplevel 2>/dev/null || true)"; do [ -n "$root" ] && [ -f "$root/scripts/agent-bus-hook-bridge.py" ] && exec python3 "$root/scripts/agent-bus-hook-bridge.py" pre-push; done; exit 0' || true
root="$(git rev-parse --show-toplevel)"
exec python3 "$root/scripts/pre_push_agent_check.py"

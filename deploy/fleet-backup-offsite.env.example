# Rotated offsite USB restic copy (#4009). Copy to fleet-backup-offsite.env locally; never commit secrets.
# SOURCE repo is the primary fleet backup (e.g. OGLaptop pilot rest-server target after #4015).
SOURCE_RESTIC_REPOSITORY=rest:http://127.0.0.1:8000/example-pilot
# Windows volume labels for the two encrypted USB SSDs (BitLocker unlocked before the job runs).
OFFSITE_USB_LABEL_A=FLEET-OFFSITE-A
OFFSITE_USB_LABEL_B=FLEET-OFFSITE-B
# restic passwords via RESTIC_PASSWORD and RESTIC_PASSWORD2 environment variables (not stored here).

# Copy to /etc/brick-restic/env (mode 0600) on Brick after DeskComputer hub is live.
# Password material stays on the host only — never commit real values.

RESTIC_REPOSITORY=rest:http://deskcomputer.tailnet-name.ts.net:8000/brick
RESTIC_PASSWORD_FILE=/etc/brick-restic/restic-password.txt
RESTIC_DRY_RUN=1
BACKUP_PATHS=/home/dieterolson/actions-runners

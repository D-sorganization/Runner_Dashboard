# Copy to /etc/node-c-restic/env (mode 0600) on node-c after hub-a rest-server is live.
# Password material stays on the host only — never commit real values.

RESTIC_REPOSITORY=rest:http://hub-a.fleet-example.ts.net:8000/node-c
RESTIC_PASSWORD_FILE=/etc/node-c-restic/restic-password.txt
RESTIC_DRY_RUN=1
BACKUP_PATHS=$HOME/actions-runners

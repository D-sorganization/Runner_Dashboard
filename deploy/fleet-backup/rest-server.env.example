# Copy to /etc/restic-rest-server/env (mode 0600, root-owned) on DeskComputer.
# Do not commit real passwords; create htpasswd out of band (see docs/runbooks/fleet-restic-backup.md).

RESTIC_REST_DATA_DIR=/var/lib/restic-rest-server/data
RESTIC_REST_HTPASSWD_FILE=/etc/restic-rest-server/htpasswd
RESTIC_REST_LISTEN_PORT=8000

# Optional: pin a rest-server release when install-rest-server.sh runs (default: latest).
# RESTIC_REST_SERVER_VERSION=0.13.0

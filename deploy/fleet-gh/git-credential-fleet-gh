#!/usr/bin/env python3
"""``git credential fill`` helper: fleet App token only."""

from __future__ import annotations

import os
import sys
from pathlib import Path
from typing import TextIO

_HERE = Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

from gh_app_credential import FleetGhMintError, mint_fleet_app_token  # noqa: E402


def main(
    *,
    stdin: TextIO | None = None,
    stdout: TextIO | None = None,
) -> int:
    inp = stdin or sys.stdin
    out = stdout or sys.stdout
    fields: dict[str, str] = {}
    for line in inp:
        line = line.strip()
        if not line:
            break
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    if fields.get("protocol") != "https" or fields.get("host") != "github.com":
        return 0
    try:
        token = mint_fleet_app_token(dict(os.environ))
    except FleetGhMintError:
        return 1
    out.write("username=x-access-token\n")
    out.write(f"password={token}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

# Deterministic-install settings (see issue #1085).
#
# - save-exact: newly added dependencies get exact versions in package.json
#   instead of floating "^"/"~" ranges, so a later `npm install` cannot
#   silently pick up a different transitive resolution than what CI verified.
# - package-lock: always write/respect package-lock.json (npm default, made
#   explicit here so it can't be disabled via a stray user-level config).
# - fund/audit noise is left at npm defaults; this file only governs
#   resolution determinism, not output verbosity.
save-exact=true
package-lock=true

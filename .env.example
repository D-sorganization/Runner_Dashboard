# runner-dashboard environment variables
# Copy this file to .env and fill in your values

# GitHub
GITHUB_ORG=D-sorganization

# Dashboard
DASHBOARD_PORT=8321
DISPLAY_NAME=
RUNNER_DASHBOARD_REPO_ROOT=
# Bind interface for uvicorn. Defaults to 0.0.0.0 (all interfaces). Set to
# 127.0.0.1 to bind loopback-only (recommended on WSL-mirrored / Tailscale hosts).
DASHBOARD_HOST=
# Opt-in to the loopback-only dev-login admin shortcut (issue #921). Leave UNSET
# in any networked/production deployment. When "1" AND the request originates
# from loopback, GET /api/auth/dev-login mints a local admin session; otherwise
# the endpoint returns 404.
DASHBOARD_DEV_LOGIN=
# Opt-in to the automatic loopback principal. Leave this variable entirely
# UNSET in any networked/production deployment.
DASHBOARD_LOOPBACK_AUTH=
# Production browser OAuth is admitted only for this exact source-controlled
# MagicDNS origin and callback. Do not substitute a raw IP, Host-header alias,
# LAN hostname, or public Funnel URL.
# Defaults to the registry hub MagicDNS HTTPS origin when unset (DeskComputer).
DASHBOARD_PUBLIC_ORIGIN=https://deskcomputer.tail2bbcc7.ts.net
GITHUB_OAUTH_CALLBACK_URL=https://deskcomputer.tail2bbcc7.ts.net/api/auth/callback
# Optional comma-separated extra origins (e.g. legacy OGLaptop during migration):
# DASHBOARD_OAUTH_ALLOWED_ORIGINS=https://oglaptop.tail2bbcc7.ts.net
# Optional external browser plane; independent of the OAuth tailnet origin.
# Leave unset until Access, owner identity and route guards are configured.
# DASHBOARD_BROWSER_PUBLIC_ORIGIN=https://ops.example.invalid
# Required for Secure session cookies on the HTTPS Tailscale Serve origin.
DASHBOARD_TLS=1

# Queue refresh budget
DASHBOARD_QUEUE_REFRESH_BUDGET_SECONDS=8
DASHBOARD_QUEUE_REPO_CONCURRENCY=6
DASHBOARD_QUEUE_JOB_CONCURRENCY=6
DASHBOARD_QUEUE_JOB_CACHE_TTL=120

# Runner limits
NUM_RUNNERS=12
MAX_RUNNERS=12
RUNNER_ALIASES=

# Disk thresholds
DASHBOARD_DISK_WARN_PERCENT=85
DASHBOARD_DISK_CRITICAL_PERCENT=92
DASHBOARD_DISK_MIN_FREE_GB=25

# GitHub API / Auth
# Fleet GitHub App user-to-server OAuth (App settings Client ID/secret; not a
# separate OAuth App). Hub-only: enable "Expire user authorization tokens" on the App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ANTHROPIC_API_KEY=
DASHBOARD_API_KEY=

# Fleet
FLEET_NODES=
HUB_URL=

# Optional read-only shared-memory context in dashboard-native Barb chat.
# Contract: docs/agents/barb-shared-memory.md
# URL is the explicit opt-in shared API origin; without it, integration is disabled.
# Token file must be readable by the dashboard service account (POSIX mode 0600).
BARB_SHARED_MEMORY_URL=
BARB_SHARED_MEMORY_TOKEN_FILE=
# Remote plain HTTP is disabled unless the operator trusts its private transport.
BARB_SHARED_MEMORY_ALLOW_HTTP=

# Maxwell
MAXWELL_URL=
MAXWELL_PORT=8080
MAXWELL_API_TOKEN=

# Scheduler
RUNNER_SCHEDULER_BIN=/usr/local/bin/runner-scheduler
RUNNER_SCHEDULER_SERVICE=runner-scheduler.service
RUNNER_SCHEDULE_CONFIG=/etc/runner-scheduler/schedule.json

# Session
# Production browser OAuth requires an explicit value of at least 32
# whitespace-free characters in the mode-0600 service EnvironmentFile.
SESSION_SECRET=

# Deployment tracking
DASHBOARD_GIT_SHA=
DASHBOARD_GIT_BRANCH=

# Machine role
MACHINE_ROLE=node

# Email intake (epic #2092) — IMAP pull; secrets via password file, never logged
# MAIL_INTAKE_ENABLED=1
# MAIL_INTAKE_ADDRESS=intake@<subdomain>.affinedrift.com
# MAIL_INTAKE_DOMAIN=<subdomain>.affinedrift.com
# MAIL_INTAKE_IMAP_HOST=imap.example.com
# MAIL_INTAKE_IMAP_USER=intake@<subdomain>.affinedrift.com
# MAIL_INTAKE_IMAP_PASSWORD_FILE=~/.config/runner-dashboard/mail-intake-imap.password
# MAIL_INTAKE_IMAP_PORT=993
# MAIL_INTAKE_IMAP_SSL=1
# MAIL_INTAKE_IMAP_FOLDER=INBOX
# MAIL_INTAKE_POLL_INTERVAL_SECONDS=120
# MAIL_INTAKE_IMAP_IDLE=0
# MAIL_INTAKE_SMTP_OUTBOUND_ENABLED=0

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.egg
pip-wheel-metadata/
.idea/
.vscode/
*.swp
*.swo
*~
*.db
*.sqlite3
*.tsbuildinfo

# Agent-local permission state. This file records approved tool calls
# verbatim, so it can capture a credential that appeared in a command.
# Ignored here rather than relying only on a machine-local global ignore.
.claude/settings.local.json
**/.claude/settings.local.json
